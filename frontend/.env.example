# ==============================================================================
# RedCell_OS — Frontend Environment Variables (.env.example)
# ==============================================================================
# All frontend environment variables exposed to Vite must be prefixed with VITE_.

# Backend Control Plane Base URL
VITE_API_URL=http://127.0.0.1:8000

# Optional explicit WebSocket URL (defaults to auto-derived from VITE_API_URL)
# VITE_WS_URL=ws://127.0.0.1:8000

# Application Metadata & Stage
VITE_APP_VERSION=0.1.0
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_2D_CANVAS=true
VITE_ENABLE_MOCK_TARGET=true
VITE_ENABLE_TERMINAL_LOGS=true
VITE_ENABLE_POC_VERIFICATION=true
