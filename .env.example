# ==============================================================================
# RedCell_OS — Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file to '.env' in your local root or backend directory to customize.
# All environment variables are prefixed with REDCELL_.

# --- Server & Control Plane ---
REDCELL_HOST=0.0.0.0
REDCELL_PORT=8000
REDCELL_ENV=development
REDCELL_LOG_LEVEL=INFO
REDCELL_JSON_LOGS=false

# --- Storage & Workspaces (ADR-004) ---
REDCELL_DATA_DIR=./data

# --- LLM Provider & Reasoning Engine (ADR-006) ---
# Active provider options: mock | anthropic | openai | ollama
REDCELL_LLM_PROVIDER=mock
REDCELL_LLM_MODEL=mock-deterministic-v1

# Cloud Provider Keys (Required only when provider is set to openai or anthropic)
# REDCELL_OPENAI_API_KEY=sk-proj-your-openai-key-here
# REDCELL_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Local / Air-gapped Model URL (When provider is set to ollama / vLLM)
REDCELL_OLLAMA_BASE_URL=http://127.0.0.1:11434
REDCELL_LLM_TEMPERATURE=0.2
REDCELL_LLM_TIMEOUT_SEC=45.0

# --- Agent Sandboxing & Quotas (ADR-005) ---
# Mode options: subprocess | docker
REDCELL_SANDBOX_MODE=subprocess
REDCELL_SANDBOX_RAM_MB=1024
REDCELL_SANDBOX_CPU_SEC=60
REDCELL_SANDBOX_TIMEOUT_SEC=120.0
